# API
PORT=3000

# PostgreSQL — valores apenas para desenvolvimento local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interview_lab

# Usuário administrador: usado só pelas migrations, pelo provisionamento e pelo seed
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres

# Senhas das roles criadas pelas migrations (aplicadas por `db:provision`)
DB_READONLY_PASSWORD=change-me-readonly
DB_APP_PASSWORD=change-me-app

# Executor de queries
DB_POOL_MAX=10
QUERY_MAX_ROWS=1000
# Timeout aplicado pelo PostgreSQL (statement_timeout), em milissegundos
QUERY_STATEMENT_TIMEOUT_MS=5000
# Timeout aplicado pela API para a execução inteira; deve ser maior que o anterior
QUERY_APP_TIMEOUT_MS=7000
# Endpoint interno POST /api/internal/queries/execute, para depurar a guarda e o
# executor (exige login). As conversas não dependem mais desta flag (Fase 08).
INTERNAL_QUERY_ENDPOINT_ENABLED=false

# LLM (D-03: Google Gemini). Crie a chave em https://aistudio.google.com/apikey
# Sem a chave a API sobe normalmente; apenas as perguntas em linguagem natural falham.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
# Linhas do resultado enviadas à LLM para escrever a explicação
LLM_EXPLAIN_MAX_ROWS=50

# Autenticação (D-08). Em produção, use um segredo aleatório com 32+ caracteres:
# a API se recusa a subir com o valor de exemplo quando NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=86400
# Origens que podem enviar requisições que alteram dados (proteção contra CSRF)
ALLOWED_ORIGINS=http://localhost:5173

# Redis: rate limit e cache (D-07b)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Limites por usuário, checados antes de chamar a LLM (D-34)
RATE_LIMIT_PER_MINUTE=10
DAILY_TOKEN_QUOTA=200000
LOGIN_ATTEMPTS_PER_MINUTE=5
# Cache de perguntas repetidas (0 desliga)
SQL_CACHE_TTL_SECONDS=3600
RESULT_CACHE_TTL_SECONDS=300
