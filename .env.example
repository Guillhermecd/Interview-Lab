# API
PORT=3000

# PostgreSQL — valores apenas para desenvolvimento local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interview_lab

# Usuário administrador: usado só pelas migrations, pelo provisionamento e pelo seed
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres

# Senhas das roles criadas pelas migrations (aplicadas por `db:provision`)
DB_READONLY_PASSWORD=change-me-readonly
DB_APP_PASSWORD=change-me-app
